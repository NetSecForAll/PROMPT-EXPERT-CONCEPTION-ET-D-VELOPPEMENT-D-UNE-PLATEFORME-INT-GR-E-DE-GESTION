# Copiez ce fichier en .env puis remplacez chaque valeur. Ne versionnez jamais .env.
ENVIRONNEMENT=developpement            # developpement | recette | production
DJANGO_SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=true                      # toujours false en production (forcé)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=plateforme
POSTGRES_USER=plateforme
POSTGRES_PASSWORD=remplacer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
TIME_ZONE=UTC                           # à adapter, ex. Africa/Abidjan (UTC+0) ou Africa/Niamey (UTC+1)
OTP_EMETTEUR=Plateforme de gestion
ALERTE_VALIDATION_EN_ATTENTE_JOURS=3
